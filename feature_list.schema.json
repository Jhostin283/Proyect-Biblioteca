{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lista de features",
  "description": "Estado de las features del harness. Cada feature corresponde a un cambio de OpenSpec.",
  "type": "object",
  "properties": {
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^feat-\\d+$",
            "description": "Identificador único (feat-001)"
          },
          "name": {
            "type": "string",
            "description": "Nombre corto de la feature"
          },
          "description": {
            "type": "string",
            "description": "Qué hace la feature"
          },
          "owner": {
            "type": "string",
            "enum": [
              "shared",
              "dev-a",
              "dev-b"
            ],
            "description": "Máquina dueña; las features shared se hacen juntos"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Features que deben estar en done antes"
          },
          "status": {
            "type": "string",
            "enum": [
              "not-started",
              "in-progress",
              "blocked",
              "done"
            ],
            "description": "Estado actual"
          },
          "openspec_change": {
            "type": "string",
            "description": "Nombre del cambio de OpenSpec (kebab-case)"
          },
          "evidence": {
            "type": "string",
            "description": "Comando de verificación y su resultado cuando status es done"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "owner",
          "status"
        ]
      }
    }
  },
  "required": [
    "features"
  ]
}
